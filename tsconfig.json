{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/apollo/*": ["apollo/*"],
      "@/components/*": ["components/*"],
      "@/graphql/*": ["graphql/*"],
      "@/fragments/*": ["graphql/fragments/*"],
      "@/types/*": ["graphql/types/*"],
      "@/lib/*": ["lib/*"]
    },
    "module": "es2020",
    "target": "es2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true
  },
  "include": ["next-env.d.ts", "typings", "**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
